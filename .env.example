# ==============================================================================
# HoneyShield Environment Configuration
# ==============================================================================

# Core Flask Security
FLASK_ENV=production
FLASK_DEBUG=false
SECRET_KEY=change-this-to-a-cryptographically-secure-random-32-byte-secret-key-in-production
PORT=5000

# Database Configuration (MySQL 8 / MariaDB, utf8mb4)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=honeyshield
DB_POOL_MIN=2
DB_POOL_MAX=20

# Initial Admin Operator Provisioning
ADMIN_EMAIL=admin@honeyshield.local
ADMIN_PASSWORD=HoneyShield@Admin2026!Secure
ADMIN_NAME=Alex Operator

# Rate Limiting & Progressive Lockout
RATELIMIT_DEFAULT=100 per minute
LOGIN_RATELIMIT_IP=10 per minute
LOGIN_RATELIMIT_ACCOUNT=5 per minute
MAX_LOGIN_FAILURES=5
LOCKOUT_MINUTES=15

# Bot Trap Honeypot Field
BOT_TRAP_FIELD=company_website

# Automated Threat Blocking (Phase 3)
BLOCK_THRESHOLD=85
ALLOWLIST_IPS=127.0.0.1,::1

# Telegram Alerts (Phase 3 - Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# External API Keys (Phase 4 - Optional)
SAFE_BROWSING_API_KEY=
PHISHTANK_API_KEY=
